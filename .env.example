# Te wartości wpisz w Vercel: Project → Settings → Environment Variables.
# Nigdy nie zapisuj prawdziwych kluczy w tym pliku ani w repozytorium.

# Cloudflare R2 (magazyn zdjęć)
# Endpoint z zakładki "European Union (EU)", np. https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lenslie

# Opcjonalnie: osobny klucz do podpisywania dostępu do galerii (domyślnie używany jest R2_SECRET_ACCESS_KEY)
SESSION_SECRET=

# Supabase (konta fotografów) – te dwie wartości nie są tajne
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
