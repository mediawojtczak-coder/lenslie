# Te wartości wpisz w Vercel: Project → Settings → Environment Variables.
# Nigdy nie zapisuj prawdziwych kluczy w tym pliku ani w repozytorium.

# Cloudflare R2 (magazyn zdjęć)
# Endpoint z zakładki "European Union (EU)", np. https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lenslie

# Opcjonalnie: osobny klucz do podpisywania dostępu do galerii (domyślnie używany jest R2_SECRET_ACCESS_KEY)
SESSION_SECRET=

# Supabase (konta fotografów) – te dwie wartości nie są tajne
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase – klucz serwisowy (TAJNY, zaczyna się od sb_secret_). Włącza ulubione, statystyki, logo w galeriach,
# panel administratora i automatyczne sprzątanie.
SUPABASE_SECRET_KEY=

# Adresy e-mail z dostępem do /admin (po przecinku)
ADMIN_EMAILS=

# Rejestracja nowych fotografów: 1 = otwarta. Wymaga włączenia zapisów i własnego SMTP w Supabase.
REGISTRATION_OPEN=

# Wysyłka e-maili (Resend) – przypomnienia o wygasaniu i powiadomienia o wyborach klientów
RESEND_API_KEY=
EMAIL_FROM=Lenslie <powiadomienia@lenslie.com>
SITE_URL=https://lenslie.vercel.app

# Klucz zadań automatycznych (dowolny długi losowy ciąg). Vercel dołącza go do wywołań cron.
CRON_SECRET=
