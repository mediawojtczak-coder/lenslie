# Skopiuj ten plik jako .env.local (lokalnie) albo wpisz te wartości
# w Vercel: Project → Settings → Environment Variables.

# Cloudflare R2 (magazyn zdjęć)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lenslie
# Twoja domena podpięta do R2, np. https://zdjecia.twojadomena.pl
R2_PUBLIC_URL=

# Supabase (baza danych i konta)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
