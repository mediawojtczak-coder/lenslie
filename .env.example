# Te wartości wpisz w Vercel: Project → Settings → Environment Variables.
# Nigdy nie zapisuj prawdziwych kluczy w tym pliku ani w repozytorium.

# Cloudflare R2 (magazyn zdjęć)
# Endpoint z zakładki "European Union (EU)", np. https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lenslie

# Tymczasowe hasło do panelu wgrywania (do czasu kont fotografów)
ADMIN_PASSWORD=

# Supabase (baza danych i konta) – później
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
